 // Windows .bmp resources don't include the BMP-file headers
 const uint8_t credit_header[] = \
@@ -485,17 +487,174 @@ bmp_files[] =
 };
 
 struct hash_struct {
-   char filename[32];
+   char filename[128];
    CFILE fd;
 };
 
 static struct hash_struct **filemap = NULL;
+static uint8_t *s_exe_mem = NULL;
+static size_t s_exe_size = 0;
 
 extern signed short wavetable[100][256];
 
+bool exe_mem_load(RFILE *fp)
+{
+   int64_t size;
+   int64_t nread;
+
+   exe_mem_free();
+   if (!fp)
+      return false;
+
+   rfseek(fp, 0, SEEK_END);
+   size = rftell(fp);
+   rfseek(fp, 0, SEEK_SET);
+   if (size <= 0)
+      return false;
+
+   s_exe_mem = (uint8_t *)malloc((size_t)size);
+   if (!s_exe_mem)
+      return false;
+
+   nread = rfread(s_exe_mem, 1, (size_t)size, fp);
+   if (nread != size)
+   {
+      free(s_exe_mem);
+      s_exe_mem = NULL;
+      return false;
+   }
+
+   s_exe_size = (size_t)size;
+   rfseek(fp, 0, SEEK_SET);
+   return true;
+}
+
+void exe_mem_free(void)
+{
+   if (s_exe_mem)
+   {
+      free(s_exe_mem);
+      s_exe_mem = NULL;
+   }
+   s_exe_size = 0;
+}
+
+bool exe_mem_read(uint32_t offset, void *dst, size_t len)
+{
+   if (!s_exe_mem || (size_t)offset > s_exe_size || len > s_exe_size - (size_t)offset)
+      return false;
+   if (len > 0)
+   {
+      if (!dst)
+         return false;
+      memcpy(dst, s_exe_mem + offset, len);
+   }
+   return true;
+}
+
+uint32_t exe_mem_getl(uint32_t *pos)
+{
+   uint32_t p = *pos;
+   if (!s_exe_mem || (size_t)p + 4 > s_exe_size)
+      return 0;
+   *pos = p + 4;
+   return ((uint32_t)s_exe_mem[p + 3] << 24)
+        | ((uint32_t)s_exe_mem[p + 2] << 16)
+        | ((uint32_t)s_exe_mem[p + 1] << 8)
+        | (uint32_t)s_exe_mem[p];
+}
+
+double exe_mem_getfloat(uint32_t *pos)
+{
+   uint32_t p = *pos;
+   double val = 0.0;
+   if (!s_exe_mem || (size_t)p + 12 > s_exe_size)
+      return 0.0;
+   *pos = p + 12;
+#ifdef MSB_FIRST
+   {
+      uint8_t rev[8];
+      int i;
+      for (i = 0; i < 8; i++)
+         rev[i] = s_exe_mem[p + 4 + 7 - i];
+      memcpy(&val, rev, sizeof(val));
+   }
+#else
+   memcpy(&val, s_exe_mem + p + 4, sizeof(val));
+#endif
+   return val;
+}
+
+static struct hash_struct *cachefiles_load_disk_entry(const char *filename, bool fallback_sprites)
+{
+   RFILE *f;
+   char fname[1024];
+   int64_t fsize;
+   struct hash_struct *entry;
+
+   if (!filename || strlen(filename) >= sizeof(entry->filename))
+      return NULL;
+
+   entry = (struct hash_struct *)calloc(sizeof(struct hash_struct), 1);
+   if (!entry)
+      return NULL;
+
+   retro_create_path_string(fname, sizeof(fname), g_dir, filename);
+   f = rfopen(fname, "rb");
+   if (!f)
+   {
+      if (fallback_sprites)
+      {
+         entry->fd.data = sprites_sif;
+         entry->fd.size = sprites_sif_size;
+         strcpy(entry->filename, filename);
+         RHMAP_SET_STR(filemap, entry->filename, entry);
+         return entry;
+      }
+      free(entry);
+      return NULL;
+   }
+
+   rfseek(f, 0, SEEK_END);
+   fsize = rftell(f);
+   rfseek(f, 0, SEEK_SET);
+   if (fsize < 0)
+   {
+      rfclose(f);
+      free(entry);
+      return NULL;
+   }
+
+   entry->fd.size = (size_t)fsize;
+   entry->fd.data = (uint8_t *)malloc(entry->fd.size);
+   if (!entry->fd.data)
+   {
+      rfclose(f);
+      free(entry);
+      return NULL;
+   }
+
+   rfread(entry->fd.data, entry->fd.size, 1, f);
+   rfclose(f);
+
+   strcpy(entry->filename, filename);
+   RHMAP_SET_STR(filemap, entry->filename, entry);
+   return entry;
+}
+
 bool cachefiles_init(RFILE *exefp)
 {
    unsigned i;
+#ifdef SF2000
+   /* On SF2000/FAT32, opening 399 individual asset files at boot stalls launch.
+    * Only sprites.sif (with built-in fallback) is registered upfront; remaining
+    * data/ files are loaded lazily on demand inside copen(). */
+   if (!RHMAP_GET_STR(filemap, "data" SLASH "sprites.sif"))
+   {
+      if (!cachefiles_load_disk_entry("data" SLASH "sprites.sif", true))
+         return false;
+   }
+#else
    for (i = 0; i < sizeof(filenames) / sizeof(filenames[0]); i++)
    {
       RFILE *f;
@@ -542,6 +701,7 @@ bool cachefiles_init(RFILE *exefp)
       strcpy(entry->filename, filenames[i]);
       RHMAP_SET_STR(filemap, entry->filename, entry);
    }
+#endif
 
    
    for (i = 0; i < sizeof(bmp_files) / sizeof(bmp_files[0]); i++)
@@ -551,6 +711,8 @@ bool cachefiles_init(RFILE *exefp)
       struct hash_struct *entry = RHMAP_GET_STR(filemap, bmp_files[i].filename);
       if (entry)
          continue;
+      if (strlen(bmp_files[i].filename) >= sizeof(entry->filename))
+         continue;
       entry = (struct hash_struct *) calloc(sizeof(struct hash_struct), 1);
       if (!entry)
          continue;
@@ -563,8 +725,11 @@ bool cachefiles_init(RFILE *exefp)
       if (bmp_files[i].header)
          memcpy(entry->fd.data, bmp_files[i].header, 25);
 
-      rfseek(exefp, bmp_files[i].offset, SEEK_SET);
-      rfread(entry->fd.data + hoff, bmp_files[i].length, 1, exefp);
+      if (!exe_mem_read(bmp_files[i].offset, entry->fd.data + hoff, bmp_files[i].length))
+      {
+         rfseek(exefp, bmp_files[i].offset, SEEK_SET);
+         rfread(entry->fd.data + hoff, bmp_files[i].length, 1, exefp);
+      }
 
       // wavetable.dat
       if (strcmp(bmp_files[i].filename, "wavetable.dat") == 0)
@@ -623,6 +788,8 @@ CFILE *copen(const char *fname, const char *mode)
       return NULL;
 
    entry = RHMAP_GET_STR(filemap, fname);
+   if (!entry)
+      entry = cachefiles_load_disk_entry(fname, false);
    if (!entry)
    {
       free(f);
