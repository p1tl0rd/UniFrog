+/* ---------------------------------------------------------------------------
+ * WAV (PCM & IMA-ADPCM) stream decoder -> mono int16_t
+ * --------------------------------------------------------------------------- */
+
+static const int8_t s_imaIndexTable[16] = {
+    -1, -1, -1, -1, 2, 4, 6, 8,
+    -1, -1, -1, -1, 2, 4, 6, 8
+};
+
+static const int16_t s_imaStepTable[89] = {
+    7, 8, 9, 10, 11, 12, 13, 14, 16, 17,
+    19, 21, 23, 25, 28, 31, 34, 37, 41, 45,
+    50, 55, 60, 66, 73, 80, 88, 97, 107, 118,
+    130, 143, 157, 173, 190, 209, 230, 253, 279, 307,
+    337, 371, 408, 449, 494, 544, 598, 658, 724, 796,
+    876, 963, 1060, 1166, 1282, 1411, 1552, 1707, 1878, 2066,
+    2272, 2499, 2749, 3024, 3327, 3660, 4026, 4428, 4871, 5358,
+    5894, 6484, 7132, 7845, 8630, 9493, 10442, 11487, 12635, 13899,
+    15289, 16818, 18500, 20350, 22385, 24623, 27086, 29794, 32767
+};
+
+static inline int32_t imaStep(uint8_t nibble, int32_t* predictor, int32_t* stepIndex) {
+    int32_t idx = *stepIndex;
+    int32_t step = s_imaStepTable[idx];
+    int32_t diff = step >> 3;
+    if (nibble & 1) diff += step >> 2;
+    if (nibble & 2) diff += step >> 1;
+    if (nibble & 4) diff += step;
+    if (nibble & 8) diff = -diff;
+
+    int32_t pred = *predictor + diff;
+    if (pred > 32767) pred = 32767;
+    else if (pred < -32768) pred = -32768;
+
+    idx += s_imaIndexTable[nibble & 15];
+    if (idx < 0) idx = 0;
+    else if (idx > 88) idx = 88;
+
+    *predictor = pred;
+    *stepIndex = idx;
+    return pred;
+}
+
+typedef struct {
+    uint16_t formatTag;
+    uint16_t channels;
+    uint32_t sampleRate;
+    uint16_t blockAlign;
+    uint16_t bitsPerSample;
+    uint16_t samplesPerBlock;
+    uint32_t dataOffset;
+    uint32_t dataSize;
+    uint32_t bytesRemaining;
+    uint8_t* blockBuf;
+    uint32_t blockBufCap;
+} WavStreamState;
+
+static bool wavStreamOpen(AudioDataSource* src, WavStreamState* wav) {
+    memset(wav, 0, sizeof(*wav));
+    uint8_t riff[12];
+    if (srcRead(src, riff, 12) != 12) return false;
+    if (memcmp(riff, "RIFF", 4) != 0 || memcmp(riff + 8, "WAVE", 4) != 0) return false;
+
+    bool gotFmt = false;
+    bool gotData = false;
+    uint8_t chunkHdr[8];
+    while (srcRead(src, chunkHdr, 8) == 8) {
+        uint32_t chunkLen = readU32LE(chunkHdr + 4);
+        uint32_t bodyPos = srcTell(src);
+
+        if (memcmp(chunkHdr, "fmt ", 4) == 0 && chunkLen >= 16) {
+            uint8_t fmt[40];
+            size_t want = chunkLen < sizeof(fmt) ? chunkLen : sizeof(fmt);
+            if (srcRead(src, fmt, want) != want) return false;
+            wav->formatTag = readU16LE(fmt + 0);
+            wav->channels = readU16LE(fmt + 2);
+            wav->sampleRate = readU32LE(fmt + 4);
+            wav->blockAlign = readU16LE(fmt + 12);
+            wav->bitsPerSample = readU16LE(fmt + 14);
+            if (wav->formatTag == 0x0011 && want >= 20) {
+                wav->samplesPerBlock = readU16LE(fmt + 18);
+            }
+            gotFmt = true;
+        } else if (memcmp(chunkHdr, "data", 4) == 0) {
+            wav->dataOffset = bodyPos;
+            wav->dataSize = chunkLen;
+            wav->bytesRemaining = chunkLen;
+            gotData = true;
+        }
+
+        if (gotFmt && gotData) break;
+        uint32_t nextPos = bodyPos + ((chunkLen + 1u) & ~1u);
+        if (!srcSeek(src, nextPos)) break;
+    }
+
+    if (!gotFmt || !gotData || wav->dataSize == 0 ||
+        (wav->channels != 1 && wav->channels != 2) || wav->sampleRate == 0) {
+        return false;
+    }
+
+    if (wav->formatTag == 1) {
+        if (wav->bitsPerSample != 16) return false;
+        if (wav->blockAlign == 0) wav->blockAlign = (uint16_t)(wav->channels * 2);
+    } else if (wav->formatTag == 0x0011) {
+        if (wav->bitsPerSample != 4 || wav->blockAlign < wav->channels * 4) return false;
+        if (wav->samplesPerBlock == 0) {
+            wav->samplesPerBlock = (uint16_t)(((wav->blockAlign - 4 * wav->channels) * 8) / (4 * wav->channels) + 1);
+        }
+    } else {
+        return false;
+    }
+
+    uint32_t bufNeed = (wav->formatTag == 1) ? 2048u : wav->blockAlign;
+    wav->blockBuf = (uint8_t*)malloc(bufNeed);
+    if (!wav->blockBuf) return false;
+    wav->blockBufCap = bufNeed;
+
+    return srcSeek(src, wav->dataOffset);
+}
+
+static void wavStreamClose(WavStreamState* wav) {
+    free(wav->blockBuf);
+    memset(wav, 0, sizeof(*wav));
+}
+
+static bool wavStreamRewind(AudioDataSource* src, WavStreamState* wav) {
+    wav->bytesRemaining = wav->dataSize;
+    return srcSeek(src, wav->dataOffset);
+}
+
+static int wavStreamDecodeMono(AudioDataSource* src, WavStreamState* wav, int16_t* outMono, int maxOut) {
+    if (wav->bytesRemaining == 0 || maxOut <= 0) return 0;
+
+    if (wav->formatTag == 1) {
+        uint32_t bpf = (uint32_t)wav->channels * 2u;
+        uint32_t wantFrames = (uint32_t)maxOut;
+        uint32_t maxFramesBuf = wav->blockBufCap / bpf;
+        if (wantFrames > maxFramesBuf) wantFrames = maxFramesBuf;
+        uint32_t wantBytes = wantFrames * bpf;
+        if (wantBytes > wav->bytesRemaining) {
+            wantBytes = (wav->bytesRemaining / bpf) * bpf;
+        }
+        if (wantBytes < bpf) {
+            wav->bytesRemaining = 0;
+            return 0;
+        }
+        size_t got = srcRead(src, wav->blockBuf, wantBytes);
+        got -= got % bpf;
+        if (got == 0) {
+            wav->bytesRemaining = 0;
+            return 0;
+        }
+        wav->bytesRemaining -= (uint32_t)got;
+        int frames = (int)(got / bpf);
+        const int16_t* pcm = (const int16_t*)wav->blockBuf;
+        if (wav->channels == 1) {
+            memcpy(outMono, pcm, (size_t)frames * sizeof(int16_t));
+        } else {
+            for (int i = 0; i < frames; i++) {
+                outMono[i] = (int16_t)(((int32_t)pcm[i * 2] + (int32_t)pcm[i * 2 + 1]) >> 1);
+            }
+        }
+        return frames;
+    }
+
+    /* IMA-ADPCM (formatTag == 0x0011) */
+    uint32_t blkSize = wav->blockAlign;
+    if (blkSize > wav->bytesRemaining) blkSize = wav->bytesRemaining;
+    if (blkSize < (uint32_t)wav->channels * 4u) {
+        wav->bytesRemaining = 0;
+        return 0;
+    }
+    size_t got = srcRead(src, wav->blockBuf, blkSize);
+    if (got < (size_t)wav->channels * 4u) {
+        wav->bytesRemaining = 0;
+        return 0;
+    }
+    wav->bytesRemaining -= (uint32_t)got;
+
+    const uint8_t* blk = wav->blockBuf;
+    int outCount = 0;
+    if (wav->channels == 1) {
+        int32_t pred = (int16_t)readU16LE(blk);
+        int32_t idx = blk[2];
+        if (idx > 88) idx = 88;
+        if (outCount < maxOut) outMono[outCount++] = (int16_t)pred;
+        for (size_t i = 4; i < got && outCount < maxOut; i++) {
+            uint8_t b = blk[i];
+            outMono[outCount++] = (int16_t)imaStep(b & 0x0Fu, &pred, &idx);
+            if (outCount < maxOut) {
+                outMono[outCount++] = (int16_t)imaStep((b >> 4) & 0x0Fu, &pred, &idx);
+            }
+        }
+    } else {
+        int32_t predL = (int16_t)readU16LE(blk + 0);
+        int32_t idxL = blk[2];
+        if (idxL > 88) idxL = 88;
+        int32_t predR = (int16_t)readU16LE(blk + 4);
+        int32_t idxR = blk[6];
+        if (idxR > 88) idxR = 88;
+        if (outCount < maxOut) outMono[outCount++] = (int16_t)((predL + predR) >> 1);
+
+        size_t pos = 8;
+        while (pos + 8 <= got && outCount < maxOut) {
+            const uint8_t* bytesL = blk + pos;
+            const uint8_t* bytesR = blk + pos + 4;
+            for (int b = 0; b < 4 && outCount < maxOut; b++) {
+                int32_t l0 = imaStep(bytesL[b] & 0x0Fu, &predL, &idxL);
+                int32_t r0 = imaStep(bytesR[b] & 0x0Fu, &predR, &idxR);
+                outMono[outCount++] = (int16_t)((l0 + r0) >> 1);
+                if (outCount < maxOut) {
+                    int32_t l1 = imaStep((bytesL[b] >> 4) & 0x0Fu, &predL, &idxL);
+                    int32_t r1 = imaStep((bytesR[b] >> 4) & 0x0Fu, &predR, &idxR);
+                    outMono[outCount++] = (int16_t)((l1 + r1) >> 1);
+                }
+            }
+            pos += 8;
+        }
+    }
+    return outCount;
+}
