From 6f1cf487187c586a77701ba94388110bd1a46444 Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Fri, 27 Nov 2026 10:45:00 +0000
Subject: [PATCH] Use integer LUT atan2 and fast pow on SF2000

---
 fix32.h     | 22 +++++++++++----------
 lpico8lib.c | 57 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 69 insertions(+), 10 deletions(-)

diff --git a/fix32.h b/fix32.h
index 701bb6e..e47e334 100644
--- a/fix32.h
+++ b/fix32.h
@@ -198,18 +198,20 @@ struct fix32
 
     static fix32 pow(fix32 x, int y) 
     {
+        if (y == 0)
+            return fix32(1);
+        bool neg = (y < 0);
+        uint32_t exp = neg ? (uint32_t)(-(int64_t)y) : (uint32_t)y;
+        fix32 base = x;
         fix32 res = 1;
-        if (y > 0) {
-            for(int i = 0; i < y; i++) {
-                res *= x;
-            }
+        while (exp > 0) {
+            if (exp & 1u)
+                res *= base;
+            exp >>= 1;
+            if (exp > 0)
+                base *= base;
         }
-        else {
-            for(int i = 0; i > y; i--){
-                res /= x;
-            }
-        }
-        return res;
+        return neg ? (fix32(1) / res) : res;
     }
 
     static inline fix32 lshr(fix32 x, int y)
diff --git a/lpico8lib.c b/lpico8lib.c
index 28e7766..50135e6 100644
--- a/lpico8lib.c
+++ b/lpico8lib.c
@@ -107,6 +107,62 @@ static int pico8_sin(lua_State *l) {
 }
 #endif
 
+#if defined(SF2000)
+static const int32_t s_p8_atan_lut[65] = {
+       0,  163,  326,  489,  651,  813,  975, 1136,
+    1297, 1457, 1617, 1775, 1933, 2090, 2246, 2401,
+    2555, 2708, 2860, 3010, 3159, 3307, 3453, 3599,
+    3742, 3884, 4025, 4164, 4302, 4438, 4572, 4705,
+    4836, 4966, 5094, 5220, 5344, 5467, 5589, 5708,
+    5826, 5943, 6058, 6171, 6282, 6392, 6500, 6607,
+    6712, 6815, 6917, 7018, 7117, 7214, 7310, 7405,
+    7498, 7589, 7679, 7768, 7856, 7942, 8026, 8110,
+    8192
+};
+
+static int pico8_atan2(lua_State *l) {
+    int32_t xb = lua_tonumber(l, 1).bits();
+    int32_t yb = lua_tonumber(l, 2).bits();
+    if (xb == 0 && yb == 0) {
+        lua_pushnumber(l, lua_Number::frombits(0xC000));
+        return 1;
+    }
+    uint32_t ax = (uint32_t)(xb < 0 ? -(int64_t)xb : (int64_t)xb);
+    uint32_t ay = (uint32_t)(yb < 0 ? -(int64_t)yb : (int64_t)yb);
+    int32_t angle;
+    if (ax >= ay) {
+        uint32_t r = (uint32_t)(((uint64_t)ay << 16) / ax);
+        uint32_t idx = r >> 10;
+        int32_t q;
+        if (idx >= 64u) {
+            q = 8192;
+        } else {
+            int32_t frac = (int32_t)(r & 1023u);
+            int32_t a = s_p8_atan_lut[idx];
+            int32_t b = s_p8_atan_lut[idx + 1u];
+            q = a + (((b - a) * frac) >> 10);
+        }
+        if (xb >= 0) angle = (yb <= 0) ? q : ((65536 - q) & 65535);
+        else         angle = (yb <= 0) ? (32768 - q) : (32768 + q);
+    } else {
+        uint32_t r = (uint32_t)(((uint64_t)ax << 16) / ay);
+        uint32_t idx = r >> 10;
+        int32_t q;
+        if (idx >= 64u) {
+            q = 8192;
+        } else {
+            int32_t frac = (int32_t)(r & 1023u);
+            int32_t a = s_p8_atan_lut[idx];
+            int32_t b = s_p8_atan_lut[idx + 1u];
+            q = a + (((b - a) * frac) >> 10);
+        }
+        if (yb < 0) angle = (xb >= 0) ? (16384 - q) : (16384 + q);
+        else        angle = (xb >= 0) ? (49152 + q) : (49152 - q);
+    }
+    lua_pushnumber(l, lua_Number::frombits(angle));
+    return 1;
+}
+#else
 static int pico8_atan2(lua_State *l) {
     lua_Number x = lua_tonumber(l, 1);
     lua_Number y = lua_tonumber(l, 2);
@@ -116,6 +172,7 @@ static int pico8_atan2(lua_State *l) {
     lua_pushnumber(l, cast_num(a >= 1 ? a - 1 : a));
     return 1;
 }
+#endif
 
 #if defined(SF2000)
 static int pico8_sqrt(lua_State *l) {
