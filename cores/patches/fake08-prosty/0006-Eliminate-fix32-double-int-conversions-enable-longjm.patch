From ddffdccf2741b203e92693a278b62b68860591e0 Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Fri, 27 Nov 2026 10:45:00 +0000
Subject: [PATCH] Eliminate fix32-double-int conversions, enable
 longjmp/-fno-exceptions, integer tline, split 30fps audio

---
 platform/libretro/Makefile     |   2 +-
 platform/libretro/libretro.cpp |  21 ++-
 source/graphics.cpp            |  27 ++--
 source/picoluaapi.cpp          | 256 +++++++++++++++++----------------
 4 files changed, 160 insertions(+), 146 deletions(-)

diff --git a/platform/libretro/Makefile b/platform/libretro/Makefile
index e2112a5..50540f8 100644
--- a/platform/libretro/Makefile
+++ b/platform/libretro/Makefile
@@ -152,7 +152,7 @@ else ifeq ($(platform), sf2000)
    AR = $(MIPS)ar
    CFLAGS = -EL -march=mips32 -mtune=mips32 -msoft-float -G0 -mno-abicalls -fno-pic
    CFLAGS += -ffast-math -fomit-frame-pointer -ffunction-sections -fdata-sections
-   CFLAGS += -DSF2000 -DENABLE_AUDIO_OPTIMIZATIONS
+   CFLAGS += -DSF2000 -DENABLE_AUDIO_OPTIMIZATIONS -DLUA_USE_LONGJMP -fno-exceptions -DNDEBUG
    # -D_NEED_FULL_PATH_
    CXXFLAGS := $(CFLAGS)
    STATIC_LINKING = 1
diff --git a/platform/libretro/libretro.cpp b/platform/libretro/libretro.cpp
index feff865..e5d6e4b 100644
--- a/platform/libretro/libretro.cpp
+++ b/platform/libretro/libretro.cpp
@@ -751,26 +751,25 @@ EXPORT void retro_run()
         kDown = currKDown;
 
         // Audio rendering - enable by default, allow SF2000 option to disable
+#ifndef SF2000
         bool should_play_audio = true;
         if (should_play_audio) {
-#ifdef SF2000
-            if (_vm->getTargetFps() == 60) {
-                size_t batch_samples = (frame & 1) ? 368 : 367;
-                _audio->FillAudioBuffer(&audioBuffer, 0, batch_samples);
-                audio_batch_cb(audioBuffer, batch_samples);
-            } else if ((frame & 1) == 0) {
-                _audio->FillAudioBuffer(&audioBuffer, 0, SAMPLESPERFRAME);
-                audio_batch_cb(audioBuffer, SAMPLESPERFRAME);
-            }
-#else
             // Regular stereo optimization - every other frame
             if (frame % 2 == 0) {
                 _audio->FillAudioBuffer(&audioBuffer, 0, SAMPLESPERFRAME);
                 audio_batch_cb(audioBuffer, SAMPLESPERFRAME);
             }
-#endif
         }
+#endif
+    }
+
+#ifdef SF2000
+    {
+        size_t batch_samples = (frame & 1) ? 368 : 367;
+        _audio->FillAudioBuffer(&audioBuffer, 0, batch_samples);
+        audio_batch_cb(audioBuffer, batch_samples);
     }
+#endif
 
     uint8_t* picoFb = _vm->GetPicoInteralFb();
     uint8_t* screenPaletteMap = _vm->GetScreenPaletteMap();
diff --git a/source/graphics.cpp b/source/graphics.cpp
index 4540f4b..fdf6e1c 100644
--- a/source/graphics.cpp
+++ b/source/graphics.cpp
@@ -925,10 +925,6 @@ void Graphics::tline(int x0, int y0, int x1, int y1, fix32 mx, fix32 my, fix32 m
 	applyCameraToPoint(&x0, &y0);
 	applyCameraToPoint(&x1, &y1);
 
-	// Pre-compute inverse ranges to avoid expensive divisions in inner loop
-	float inv_x_range = (x1 != x0) ? (1.0f / (x1 - x0)) : 0.0f;
-	float inv_y_range = (y1 != y0) ? (1.0f / (y1 - y0)) : 0.0f;
-
 	//determine whether x or y coordinates need to get incremented
 	bool xDifGreater = std::abs(x1 - x0) >= std::abs(y1 - y0);
 	int dx = xDifGreater ? x0 <= x1 ? 1 : -1 : 0;
@@ -941,6 +937,21 @@ void Graphics::tline(int x0, int y0, int x1, int y1, fix32 mx, fix32 my, fix32 m
 	int y = clampYCoordToClip(y0);
 	int yend = clampYCoordToClip(y1);
 
+	int64_t y_q16 = (int64_t)y0 * 65536;
+	int64_t y_step_q16 = 0;
+	if (xDifGreater && x1 != x0) {
+		int64_t slope_q16 = ((int64_t)(y1 - y0) * 65536) / (x1 - x0);
+		y_q16 += (int64_t)(x - x0) * slope_q16;
+		y_step_q16 = slope_q16 * dx;
+	}
+	int64_t x_q16 = (int64_t)x0 * 65536;
+	int64_t x_step_q16 = 0;
+	if (!xDifGreater && !vertical && y1 != y0) {
+		int64_t slope_q16 = ((int64_t)(x1 - x0) * 65536) / (y1 - y0);
+		x_q16 += (int64_t)(y - y0) * slope_q16;
+		x_step_q16 = slope_q16 * dy;
+	}
+
 	auto &ds = _memory->drawState;
 
 	// Retrieve masks for wrap-around and subtract 0x0.0001
@@ -990,16 +1001,16 @@ void Graphics::tline(int x0, int y0, int x1, int y1, fix32 mx, fix32 my, fix32 m
             if (x == xend)
                 break;
             x += dx;
-            // Avoid expensive division in inner loop - critical for MIPS
-            y = y0 + ((float)(x - x0) * inv_x_range) * (y1 - y0);
+            y_q16 += y_step_q16;
+            y = (int)(y_q16 >> 16);
         }
         else {
             if (y == yend)
                 break;
             y += dy;
 			if (! vertical) {
-            	// Avoid expensive division in inner loop - critical for MIPS
-            	x = x0 + ((float)(y - y0) * inv_y_range) * (x1 - x0);
+            	x_q16 += x_step_q16;
+            	x = (int)(x_q16 >> 16);
 			}
 		}
 	}
