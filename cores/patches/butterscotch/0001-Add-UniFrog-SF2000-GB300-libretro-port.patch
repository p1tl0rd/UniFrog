diff --git a/Makefile.unifrog b/Makefile.unifrog
new file mode 100644
index 0000000000000000000000000000000000000000..e92cadb3273cb672195f0be8af2bae544fbd53e1
--- /dev/null
+++ b/Makefile.unifrog
@@ -0,0 +1,90 @@
+# Butterscotch -> UniFrog (GB300V2 / SF2000) static library build
+
+TARGET := butterscotch_libretro_sf2000.a
+OBJDIR := build/unifrog
+
+CC ?= mipsel-mti-elf-gcc
+AR ?= mipsel-mti-elf-ar
+LIBRETRO_COMMON_INC ?= ../libretro-common/include
+
+CFLAGS := -EL -march=mips32 -mtune=mips32r2 -msoft-float
+CFLAGS += -G0 -mno-abicalls -fno-pic
+CFLAGS += -ffunction-sections -fdata-sections
+CFLAGS += -fno-strict-aliasing -fomit-frame-pointer -O2 -DNDEBUG
+
+INCLUDES := \
+	-I. \
+	-Isrc \
+	-Isrc/image \
+	-Isrc/video \
+	-Isrc/audio \
+	-Isrc/debug_font \
+	-Isrc/sf2000 \
+	-Isrc/sw_renderer \
+	-Ivendor/stb/ds \
+	-Ivendor/stb/image \
+	-Ivendor/stb/vorbis \
+	-Ivendor/bzip2 \
+	-Ivendor/md5 \
+	-Ivendor/miniz \
+	-Ivendor/sha1 \
+	-Ivendor/base64 \
+	-I$(LIBRETRO_COMMON_INC)
+
+DEFINES := \
+	-DSF2000 \
+	-DPLATFORM_SF3000 \
+	-DPLATFORM_UNIFROG \
+	-DENABLE_SW_RENDERER \
+	-DENABLE_WAD16 \
+	-DDISABLE_WAD14 \
+	-DDISABLE_WAD17 \
+	-DBUTTERSCOTCH_VIDEO_NULL=1 \
+	-DNO_THREADS \
+	-DUSE_SDL2=0 \
+	-DMINIZ_NO_ARCHIVE_APIS \
+	-DMINIZ_NO_STDIO \
+	-DDISABLE_VM_GML_PROFILER \
+	-DDISABLE_VM_OPCODE_PROFILER \
+	-DDISABLE_VM_STUB_LOGS \
+	-DDISABLE_VM_TRACING \
+	-DDISABLE_SPATIAL_GRID_LOGS \
+	-DDISABLE_VM_EXCEPTIONS_LOGS \
+	-DBUTTERSCOTCH_COMMIT_DATE=\"unifrog\" \
+	-DBUTTERSCOTCH_COMMIT_HASH=\"c43543e\"
+
+SRCS := \
+	$(filter-out src/embedded/%.c,$(wildcard src/*.c)) \
+	$(wildcard src/image/*.c) \
+	$(wildcard src/debug_font/*.c) \
+	$(wildcard src/sw_renderer/*.c) \
+	src/physics/physics.c \
+	src/physics/disabled/physics_disabled.c \
+	src/video/null_video.c \
+	src/sf3000/main.c \
+	src/backends/libretro.c \
+	src/sf2000/sf2000_audio.c \
+	src/sf2000/stb_impl.c \
+	vendor/stb/vorbis/stb_vorbis.c \
+	$(wildcard vendor/bzip2/*.c) \
+	$(wildcard vendor/miniz/*.c) \
+	vendor/md5/md5.c \
+	vendor/sha1/sha1.c \
+	vendor/base64/base64.c
+
+OBJS := $(addprefix $(OBJDIR)/,$(SRCS:.c=.o))
+
+all: $(TARGET)
+
+$(TARGET): $(OBJS)
+	@rm -f $@
+	$(AR) rcs $@ $(OBJS)
+
+$(OBJDIR)/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) $(INCLUDES) $(DEFINES) -c -o $@ $<
+
+clean:
+	rm -rf $(OBJDIR) $(TARGET)
+
+.PHONY: all clean
