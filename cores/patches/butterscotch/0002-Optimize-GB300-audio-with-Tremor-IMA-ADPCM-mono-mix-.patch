+static void closeStreamSlot(SoundSlot* slot) {
+    if (!slot) return;
+    if (slot->streamKind == STREAM_WAV_FILE) {
+        wavStreamClose(&slot->dec.wav);
+    }
+#ifdef USE_HCRTOS_TREMOR
+    else if (slot->streamKind == STREAM_OGG_TREMOR) {
+        tremorStreamClose(&slot->dec.tremor);
