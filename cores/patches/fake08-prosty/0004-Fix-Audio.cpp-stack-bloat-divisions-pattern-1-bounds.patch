diff --git a/source/graphics.cpp b/source/graphics.cpp
index e12aafbdbe545f92d5ca4333718572f2a2cfa710..4540f4b003b4966bf6fd598db69f6d81da1f5193 100644
--- a/source/graphics.cpp
+++ b/source/graphics.cpp
@@ -124,6 +124,65 @@ void Graphics::copySpriteToScreen(
 		startWithHalf = true;
 	}
 
+	if (hwState.colorBitmask == 0xff) {
+		const uint8_t *pal = drawState.drawPaletteMap;
+		for (int y = 0; y < scr_h; y++) {
+			int abs_spr_y = spr_y + (flip_y ? spr_h - (y + 1) : y);
+			if ((unsigned)abs_spr_y >= 128u)
+				continue;
+			const int finaly = scr_y + y;
+			uint8_t *rowDst = screenBuffer + (finaly << 6);
+			const uint8_t *sprRow = spritebuffer + (abs_spr_y << 6);
+			int x = 0;
+			while (x < scr_w) {
+				int abs_spr_x = spr_x + (flip_x ? spr_w - (x + 1) : x);
+				if ((unsigned)abs_spr_x >= 128u) {
+					++x;
+					continue;
+				}
+				uint8_t bothPix = sprRow[abs_spr_x >> 1];
+				uint8_t lc = bothPix & 0x0f;
+				uint8_t rc = bothPix >> 4;
+				int finalx = scr_x + (flip_x ? x + 1 : x);
+
+				if (!flip_x && (x > 0 || !startWithHalf) && (x + 1 < scr_w) && ((finalx & 1) == 0)) {
+					uint8_t pl = pal[lc];
+					uint8_t pr = pal[rc];
+					if (!(pl >> 4) && !(pr >> 4)) {
+						rowDst[finalx >> 1] = (uint8_t)((pl & 0x0f) | ((pr & 0x0f) << 4));
+						x += 2;
+						continue;
+					}
+				}
+
+				if (x > 0 || !startWithHalf) {
+					uint8_t pl = pal[lc];
+					if (!(pl >> 4)) {
+						uint8_t c = pl & 0x0f;
+						uint8_t *dst = &rowDst[finalx >> 1];
+						*dst = (finalx & 1) ? (uint8_t)((*dst & 0x0f) | (c << 4)) : (uint8_t)((*dst & 0xf0) | c);
+					}
+					++x;
+					if (flip_x)
+						--finalx;
+					else
+						++finalx;
+				}
+
+				if (x < scr_w) {
+					uint8_t pr = pal[rc];
+					if (!(pr >> 4)) {
+						uint8_t c = pr & 0x0f;
+						uint8_t *dst = &rowDst[finalx >> 1];
+						*dst = (finalx & 1) ? (uint8_t)((*dst & 0x0f) | (c << 4)) : (uint8_t)((*dst & 0xf0) | c);
+					}
+					++x;
+				}
+			}
+		}
+		return;
+	}
+
 	//since we get 2 pixels at a time, don't go through this whole loop every pixel
 	for (int y = 0; y < scr_h; y++) {
 		int x = 0;
@@ -1610,11 +1669,49 @@ void Graphics::map(int celx, int cely, int sx, int sy, int celw, int celh) {
 }
 
 void Graphics::map(int celx, int cely, int sx, int sy, int celw, int celh, uint8_t layer) {
+	auto &drawState = _memory->drawState;
+	auto &hwState = _memory->hwState;
+	const bool bigMap = hwState.mapMemMapping >= 0x80;
+	const int bigMapLocation = hwState.mapMemMapping << 8;
+	const int mapSize = bigMap ? (0x10000 - bigMapLocation) : 8192;
+	const int mapW = hwState.widthOfTheMap == 0 ? 256 : hwState.widthOfTheMap;
+	const int mapH = mapSize / mapW;
+	const int bigMapOffset = 0x8000 - mapSize;
+	uint8_t * const spriteSheet = GetP8SpriteSheetBuffer();
+
+	const int clip_xb = (int)drawState.clip_xb + drawState.camera_x;
+	const int clip_xe = (int)drawState.clip_xe + drawState.camera_x;
+	const int clip_yb = (int)drawState.clip_yb + drawState.camera_y;
+	const int clip_ye = (int)drawState.clip_ye + drawState.camera_y;
+
 	for (int y = 0; y < celh; y++) {
+		int cy = cely + y;
+		int py = sy + (y << 3);
+		if (cy < 0 || cy >= mapH)
+			continue;
+		if (py + 8 <= clip_yb || py >= clip_ye)
+			continue;
+		int rowBase = cy * mapW;
 		for (int x = 0; x < celw; x++) {
-			uint8_t cell = mget(celx + x, cely + y);
-			if (cell && ((layer == 0) || (fget(cell) & layer))) {
-				spr(cell, sx + x * 8, sy + y * 8);
+			int cx = celx + x;
+			int px = sx + (x << 3);
+			if (cx < 0 || cx >= mapW)
+				continue;
+			if (px + 8 <= clip_xb || px >= clip_xe)
+				continue;
+			int idx = rowBase + cx;
+			uint8_t cell;
+			if (bigMap) {
+				cell = _memory->userData[bigMapOffset + idx];
+			} else if (idx < 4096) {
+				cell = _memory->mapData[idx];
+			} else {
+				cell = _memory->spriteSheetData[idx];
+			}
+			if (cell && ((layer == 0) || (_memory->spriteFlags[cell] & layer))) {
+				int spr_x = (cell & 15) << 3;
+				int spr_y = (cell >> 4) << 3;
+				copySpriteToScreen(spriteSheet, px, py, spr_x, spr_y, 8, 8, false, false);
 			}
 		}
 	}
