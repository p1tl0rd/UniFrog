+++ b/src/sw_renderer/atlas.c
@@ -100,9 +100,15 @@ bool SwAtlas_open(SwAtlas* atlas, const char* dir) {
     atlas->pixels = fopen(path, "rb");
     if (!atlas->pixels) { free(recs); return false; }
 
+    atlas->ioBuf = (char*)malloc(16384);
+    if (atlas->ioBuf) {
+        setvbuf(atlas->pixels, atlas->ioBuf, _IOFBF, 16384);
+    }
+
     atlas->byTpag = (SwAtlasBlock**)calloc((size_t)count, sizeof(SwAtlasBlock*));
     if (!atlas->byTpag) {
         fclose(atlas->pixels);
+        free(atlas->ioBuf);
         free(recs);
         return false;
     }
@@ -115,6 +121,7 @@ bool SwAtlas_open(SwAtlas* atlas, const char* dir) {
 void SwAtlas_close(SwAtlas* atlas) {
     SwAtlasCache_clear(atlas);
     if (atlas->pixels) fclose(atlas->pixels);
+    free(atlas->ioBuf);
     free(atlas->byTpag);
     free(atlas->records);
     memset(atlas, 0, sizeof(*atlas));
