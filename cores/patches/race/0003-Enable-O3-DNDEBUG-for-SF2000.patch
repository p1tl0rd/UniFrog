From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Fri, 27 Nov 2026 11:19:30 +0000
Subject: [PATCH 3/3] Enable -O3 -DNDEBUG for SF2000

---
 Makefile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Makefile b/Makefile
index 2e31288386167ea5cae29b66a8944eaf09f5f49b..49d568ed160721f814242ea25828fb1a6a1ea778 100644
--- a/Makefile
+++ b/Makefile
@@ -600,6 +600,8 @@ OBJECTS := $(SOURCES_C:.c=.o) $(SOURCES_ASM:.s=.o)
 
 ifeq ($(DEBUG),1)
 FLAGS += -O0 -g
+else ifeq ($(platform), sf2000)
+FLAGS += -O3 -DNDEBUG
 else
 FLAGS += -O2 -DNDEBUG
 endif
