From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Sat, 28 Nov 2026 10:59:58 +0700
Subject: [PATCH 5/5] Cache ROOM chunk in RAM to eliminate lazy room fseek
 hangs and reduce BGM/atlas stalls

---
 src/data_win.c                | 32 ++++++++++++++++++++++++----
 src/data_win.h                |  3 +++
 src/runner.c                  |  8 +++++--
 src/sf2000/sf2000_audio.c     | 39 ++++++++++++++++++++++++++++++-----
 src/sf3000/main.c             |  6 +++---
 src/sw_renderer/atlas.c       |  7 +++++++
 src/sw_renderer/atlas.h       |  1 +
 src/sw_renderer/sw_renderer.c |  2 ++
 src/vm.c                      |  4 ++++
 9 files changed, 88 insertions(+), 14 deletions(-)

diff --git a/src/data_win.c b/src/data_win.c
index 6ab9ba01a9c9b512762f0c018587b79f990d9733..4443c792f2c64f40aff1d48e5a3910648c4e636a 100644
--- a/src/data_win.c
+++ b/src/data_win.c
@@ -3065,6 +3065,12 @@ DataWin* DataWin_parse(const char* filePath, DataWinParserOptions options) {
             parseOBJT(&reader, dw);
         } else if (options.parseRoom && memcmp(chunkName, "ROOM", 4) == 0) {
             parseROOM(&reader, dw, options.lazyLoadRooms, options.eagerlyLoadedRooms);
+            if (options.lazyLoadRooms && chunkBuffer != nullptr) {
+                dw->roomChunkBuffer = chunkBuffer;
+                dw->roomChunkBase = chunkDataStart;
+                dw->roomChunkSize = chunkLength;
+                chunkBuffer = nullptr;
+            }
         } else if (memcmp(chunkName, "DAFL", 4) == 0) {
             // Empty chunk, nothing to parse
         } else if (memcmp(chunkName, "EMBI", 4) == 0) {
@@ -3388,6 +3394,8 @@ void DataWin_free(DataWin* dw) {
     // Owned buffers
     if (!dw->mappedFile)
         free(dw->strgBuffer);
+    free(dw->roomChunkBuffer);
+    dw->roomChunkBuffer = nullptr;
     free(dw->bytecodeBuffer);
 
     // Close the lazy-load file handle (only open when lazyLoadRooms/lazyLoadTextures was enabled)
@@ -3440,14 +3448,30 @@ void DataWin_freeRoomPayload(Room* room) {
     room->payloadLoaded = false;
 }
 
+static bool offsetInRange(uint32_t off, size_t base, size_t size) {
+    if (off == 0) return true;
+    return (size_t)off >= base && (size_t)off < base + size;
+}
+
 void DataWin_loadRoomPayload(DataWin* dw, int32_t roomIndex) {
     require(roomIndex >= 0 && dw->room.count > (uint32_t) roomIndex);
     Room* room = &dw->room.rooms[roomIndex];
     if (room->payloadLoaded) return;
-    requireMessage(dw->lazyLoadFile != nullptr, "DataWin_loadRoomPayload called without an open lazy-load FILE*");
-
-    FILE* f = dw->lazyLoadFile;
-    BinaryReader lazyReader = BinaryReader_create(f, dw->fileSize);
+    requireMessage(dw->lazyLoadFile != nullptr || dw->roomChunkBuffer != nullptr,
+                   "DataWin_loadRoomPayload called without an open lazy-load FILE* or ROOM buffer");
+
+    BinaryReader lazyReader = BinaryReader_create(dw->lazyLoadFile, dw->fileSize);
+    if (dw->roomChunkBuffer != nullptr &&
+        offsetInRange(room->backgroundsFileOffset, dw->roomChunkBase, dw->roomChunkSize) &&
+        offsetInRange(room->viewsFileOffset, dw->roomChunkBase, dw->roomChunkSize) &&
+        offsetInRange(room->gameObjectsFileOffset, dw->roomChunkBase, dw->roomChunkSize) &&
+        offsetInRange(room->tilesFileOffset, dw->roomChunkBase, dw->roomChunkSize) &&
+        offsetInRange(room->layersFileOffset, dw->roomChunkBase, dw->roomChunkSize)) {
+        BinaryReader_setBuffer(&lazyReader, dw->roomChunkBuffer, dw->roomChunkBase, dw->roomChunkSize);
+    } else {
+        requireMessage(dw->lazyLoadFile != nullptr,
+                       "DataWin_loadRoomPayload called without an open lazy-load FILE*");
+    }
     readRoomPayload(&lazyReader, dw, room);
 }
 
diff --git a/src/data_win.h b/src/data_win.h
index 409caa63647f53c5b3662756c6abb758eee05928..cadc001f630cebd192ccbff04f226b30b7a7281a 100644
--- a/src/data_win.h
+++ b/src/data_win.h
@@ -943,6 +943,9 @@ struct DataWin {
     // nullptr when lazy loading is disabled. Closed by DataWin_free.
     FILE* lazyLoadFile;
     uint8_t* mappedFile;
+    uint8_t* roomChunkBuffer;
+    size_t roomChunkBase;
+    size_t roomChunkSize;
     size_t fileSize; // cached size of the DataWin, captured at parse time. Used for platforms where fseek(SEEK_END)+ftell is unreliable due to buffering (like the PlayStation 2).
     bool lazyLoadRooms; // mirrors the parser option so Runner can branch without re-reading options
     bool lazyLoadTextures; // ditto, but with TXTR pages
diff --git a/src/runner.c b/src/runner.c
index 2afb4203632ebf12b04b9282c4f61cf02f24583a..680580dd54dd1073a881e4d14bc30f1febdfdfd3 100644
--- a/src/runner.c
+++ b/src/runner.c
@@ -1698,8 +1698,12 @@ static void initRoom(Runner* runner, int32_t roomIndex) {
         // Event iteration is forward (oldest first), so a persistent instance runs after the room's own instances.
         int32_t savedCount = (int32_t) arrlen(savedState->instances);
         repeat(savedCount, i) {
-            arrput(runner->instances, savedState->instances[i]);
-            Runner_addInstanceToObjectLists(runner, savedState->instances[i]);
+            Instance* inst = savedState->instances[i];
+            arrsetlen(inst->collisionCells, 0);
+            inst->spatialGridDirty = false;
+            SpatialGrid_markInstanceAsDirty(runner->spatialGrid, inst);
+            arrput(runner->instances, inst);
+            Runner_addInstanceToObjectLists(runner, inst);
         }
         arrfree(savedState->instances);
         savedState->instances = nullptr;
diff --git a/src/sf2000/sf2000_audio.c b/src/sf2000/sf2000_audio.c
index 2c3546e39ab986e43e3c5e62d1ebd4a2cd45d663..89b3a8dc680e193e345f21e54e3486ed5889b685 100644
--- a/src/sf2000/sf2000_audio.c
+++ b/src/sf2000/sf2000_audio.c
@@ -53,7 +53,7 @@ extern void stb_vorbis_close(stb_vorbis *f);
 #define MAX_SOUND_INSTANCES 16
 #define MAX_AUDIO_STREAMS 16
 
-#define AUDIO_RAM_PRELOAD_MAX (4u * 1024u * 1024u)
+#define AUDIO_RAM_PRELOAD_MAX (256u * 1024u)
 #define AUDIO_FILE_IOBUF_SIZE (16u * 1024u)
 #define STREAM_SCRATCH_CAP 8192
 
@@ -120,6 +120,8 @@ static char* tryResolveFile(FileSystem* fs, const char* candidate) {
     return NULL;
 }
 
+static bool s_preferMusPrefix = false;
+
 static char* resolveAudioPath(FileSystem* fs, const char* filename) {
     if (!fs || !filename || !filename[0]) return NULL;
 
@@ -133,6 +135,17 @@ static char* resolveAudioPath(FileSystem* fs, const char* filename) {
     /* Prefer pre-converted mono IMA-ADPCM / PCM .wav over .ogg when present */
     if (isOgg) {
         char wavCand[512];
+        if (isMusicDir && s_preferMusPrefix) {
+            const char* baseDot = strrchr(base, '.');
+            if (baseDot) {
+                int len = snprintf(wavCand, sizeof(wavCand), "mus_%.*s.wav",
+                                   (int)(baseDot - base), base);
+                if (len > 0 && (size_t)len < sizeof(wavCand)) {
+                    char* p = tryResolveFile(fs, wavCand);
+                    if (p) return p;
+                }
+            }
+        }
         size_t stemLen = (size_t)(dot - filename);
         if (stemLen + 5 <= sizeof(wavCand)) {
             memcpy(wavCand, filename, stemLen);
@@ -140,30 +153,45 @@ static char* resolveAudioPath(FileSystem* fs, const char* filename) {
             char* p = tryResolveFile(fs, wavCand);
             if (p) return p;
         }
-        if (isMusicDir) {
+        if (isMusicDir && !s_preferMusPrefix) {
             const char* baseDot = strrchr(base, '.');
             if (baseDot) {
                 int len = snprintf(wavCand, sizeof(wavCand), "mus_%.*s.wav",
                                    (int)(baseDot - base), base);
                 if (len > 0 && (size_t)len < sizeof(wavCand)) {
                     char* p = tryResolveFile(fs, wavCand);
-                    if (p) return p;
+                    if (p) {
+                        s_preferMusPrefix = true;
+                        return p;
+                    }
                 }
             }
         }
     }
 
+    if (isMusicDir && isOgg && n > 4 && s_preferMusPrefix) {
+        char mapped[512];
+        int len = snprintf(mapped, sizeof(mapped), "mus_%s", base);
+        if (len > 0 && (size_t)len < sizeof(mapped)) {
+            char* p = tryResolveFile(fs, mapped);
+            if (p) return p;
+        }
+    }
+
     char* p = tryResolveFile(fs, filename);
     if (p) return p;
 
     /* Undertale's GML uses music/name.ogg; its Linux package names these
      * same tracks mus_name.ogg beside game.unx. */
-    if (isMusicDir && isOgg && n > 4) {
+    if (isMusicDir && isOgg && n > 4 && !s_preferMusPrefix) {
         char mapped[512];
         int len = snprintf(mapped, sizeof(mapped), "mus_%s", base);
         if (len > 0 && (size_t)len < sizeof(mapped)) {
             p = tryResolveFile(fs, mapped);
-            if (p) return p;
+            if (p) {
+                s_preferMusPrefix = true;
+                return p;
+            }
         }
     }
     return NULL;
@@ -957,6 +985,7 @@ static void sf2000AudioDestroy(AudioSystem* audio) {
     free(audio->groupGains);
     arrfree(audio->audioGroups);
     s_audio = NULL;
+    s_preferMusPrefix = false;
     free(audio);
 }
 
