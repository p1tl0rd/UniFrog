diff --git a/source/Audio.cpp b/source/Audio.cpp
index fb52617e50268911797c4e7e16d3a323f5395178..278c06482b33cf0f716803105205e96d96e530ae 100644
--- a/source/Audio.cpp
+++ b/source/Audio.cpp
@@ -237,32 +237,576 @@ void Audio::set_music_pattern(int pattern) {
     }
 }
 
+#ifdef SF2000
+static bool s_fixed_audio_init = false;
+static uint32_t s_phase_inc_q16[64];
+static uint32_t s_inv_speed_q24[256];
+static int16_t s_vib_lut[256];
+static const int32_t s_vol_q15[8] = {
+    0, 4681, 9362, 14043, 18725, 23406, 28087, 32768
+};
+static uint32_t s_c2_freq_q16 = 0;
+static uint32_t s_noise_rng = 0x12345678u;
+static int32_t s_noise_lp = 0;
+
+static void initFixedAudioTables(void) {
+    if (s_fixed_audio_init)
+        return;
+    for (int k = 0; k < 64; k++) {
+        double freq = 440.0 * std::exp2((double)(k - 33) / 12.0);
+        double inc = (freq / 22050.0) * 65536.0;
+        s_phase_inc_q16[k] = (uint32_t)(inc + 0.5);
+    }
+    s_inv_speed_q24[0] = 0;
+    for (int spd = 1; spd < 256; spd++) {
+        s_inv_speed_q24[spd] = (uint32_t)((1ULL << 24) / (183ULL * (uint64_t)spd));
+    }
+    for (int i = 0; i < 256; i++) {
+        double v = std::sin((double)i * (2.0 * 3.14159265358979323846 / 256.0)) * 16384.0;
+        s_vib_lut[i] = (int16_t)(v >= 0.0 ? v + 0.5 : v - 0.5);
+    }
+    s_c2_freq_q16 = s_phase_inc_q16[24];
+    s_fixed_audio_init = true;
+}
+
+static inline uint32_t floatOffsetToQ24(float offset) {
+    if (offset <= 0.0f)
+        return 0u;
+    if (offset >= 255.0f)
+        return 255u << 24;
+    return (uint32_t)(offset * 16777216.0f);
+}
+
+static inline uint32_t floatPhiToQ16(float phi) {
+    if (phi <= 0.0f)
+        return 0u;
+    int32_t whole = (int32_t)phi;
+    float frac = phi - (float)whole;
+    uint32_t wmod = (uint32_t)(whole & 127);
+    int32_t fbits = (int32_t)(frac * 65536.0f);
+    return ((wmod << 16) + (uint32_t)fbits) & 0x007FFFFFu;
+}
+
+static inline int32_t evalWaveformFixed(int instrument, uint32_t phi_q16) {
+    uint32_t t_q16 = phi_q16 & 0xFFFFu;
+    switch (instrument) {
+        case z8::synth::INST_TRIANGLE: {
+            int32_t u = (int32_t)(t_q16 << 2) - 131072;
+            if (u < 0)
+                u = -u;
+            return (u - 65536) >> 2;
+        }
+        case z8::synth::INST_TILTED_SAW:
+            if (t_q16 < 58982u)
+                return (((int32_t)t_q16 * 36409) >> 16) - 16384;
+            return (((int32_t)(65536u - t_q16) * 327680) >> 16) - 16384;
+        case z8::synth::INST_SAW: {
+            int32_t st = (t_q16 < 32768u) ? (int32_t)t_q16 : (int32_t)t_q16 - 65536;
+            return (st * 21398) >> 16;
+        }
+        case z8::synth::INST_SQUARE:
+            return (t_q16 < 32768u) ? 8192 : -8192;
+        case z8::synth::INST_PULSE:
+            return (t_q16 < 21845u) ? 8192 : -8192;
+        case z8::synth::INST_ORGAN:
+            if (t_q16 < 32768u) {
+                int32_t v = 24 * (int32_t)t_q16 - (6 << 16);
+                if (v < 0)
+                    v = -v;
+                return (((3 << 16) - v) * 3641) >> 16;
+            } else {
+                int32_t v = 16 * (int32_t)t_q16 - (12 << 16);
+                if (v < 0)
+                    v = -v;
+                return (((1 << 16) - v) * 3641) >> 16;
+            }
+        case z8::synth::INST_NOISE: {
+            s_noise_rng ^= s_noise_rng << 13;
+            s_noise_rng ^= s_noise_rng >> 17;
+            s_noise_rng ^= s_noise_rng << 5;
+            int32_t r = (int32_t)(s_noise_rng >> 17) - 16384;
+            s_noise_lp = (s_noise_lp * 3 + r) >> 2;
+            return (s_noise_lp * 13107) >> 15;
+        }
+        case z8::synth::INST_PHASER: {
+            uint32_t adv_mod128 = (phi_q16 >> 7) & 0xFFFFu;
+            int32_t k = (int32_t)(adv_mod128 << 1) - 65536;
+            if (k < 0)
+                k = -k;
+            uint32_t u = (t_q16 + (uint32_t)(k >> 1)) & 0xFFFFu;
+            int32_t a = (int32_t)(u << 2) - 131072;
+            if (a < 0)
+                a = -a;
+            int32_t b = (int32_t)(t_q16 << 3) - 262144;
+            if (b < 0)
+                b = -b;
+            return ((a - b) * 5461) >> 16;
+        }
+        default:
+            return 0;
+    }
+}
+
+static inline int32_t evalChildSfxSampleFixed(PicoRam *memory, rawSfxChannel &ch,
+                                              uint32_t &off_q24, uint32_t &phi_q16,
+                                              uint32_t freq_shift_q16) {
+    if (ch.sfxId < 0 || ch.sfxId > 63)
+        return 0;
+    const struct sfx &sfx = memory->sfx[ch.sfxId];
+    int speed = sfx.speed < 1 ? 1 : (int)sfx.speed;
+    uint32_t inc_q24 = s_inv_speed_q24[speed];
+    uint32_t next_off_q24 = off_q24 + inc_q24;
+
+    int loop_start = sfx.loopRangeStart;
+    int loop_end = sfx.loopRangeEnd;
+    int loop_len = loop_end - loop_start;
+    if (loop_len > 0 && ch.can_loop) {
+        uint32_t loop_start_q24 = (uint32_t)loop_start << 24;
+        uint32_t loop_end_q24 = (uint32_t)loop_end << 24;
+        uint32_t loop_len_q24 = (uint32_t)loop_len << 24;
+        if (next_off_q24 >= loop_end_q24) {
+            next_off_q24 -= loop_len_q24;
+            if (next_off_q24 >= loop_end_q24)
+                next_off_q24 = loop_start_q24 + (next_off_q24 - loop_start_q24) % loop_len_q24;
+        }
+    }
+
+    int note_idx = (int)(off_q24 >> 24);
+    if (note_idx >= 32) {
+        ch.sfxId = -1;
+        return 0;
+    }
+    note cur_n = sfx.notes[note_idx];
+    ch.current_note.n = cur_n;
+    int next_note_idx = (int)(next_off_q24 >> 24);
+
+    uint8_t key = cur_n.getKey();
+    uint32_t freq_q16 = (key < 64) ? s_phase_inc_q16[key] : 0u;
+    int32_t vol_q15 = s_vol_q15[cur_n.getVolume() & 7];
+    uint32_t offset_part_q24 = off_q24 & 0x00FFFFFFu;
+    int32_t tmod_q15 = (int32_t)(offset_part_q24 >> 9);
+    int fx = cur_n.getEffect();
+
+    switch (fx) {
+        case FX_SLIDE: {
+            uint8_t pk = ch.prev_note.n.getKey();
+            uint32_t pf = (pk < 64) ? s_phase_inc_q16[pk] : 0u;
+            freq_q16 = (uint32_t)((int32_t)pf + (((int64_t)((int32_t)freq_q16 - (int32_t)pf) * tmod_q15) >> 15));
+            if (ch.prev_note.n.getVolume() > 0) {
+                int32_t pv = s_vol_q15[ch.prev_note.n.getVolume() & 7];
+                vol_q15 = pv + (((vol_q15 - pv) * tmod_q15) >> 15);
+            }
+            break;
+        }
+        case FX_VIBRATO: {
+            uint32_t vib_idx = (((uint32_t)tmod_q15 * (uint32_t)speed * 127u) >> 18) & 0xFFu;
+            int32_t vt = s_vib_lut[vib_idx];
+            freq_q16 = (uint32_t)((int64_t)freq_q16 + (((int64_t)freq_q16 * 3898 * vt) >> 30));
+            break;
+        }
+        case FX_DROP:
+            freq_q16 = (uint32_t)(((uint64_t)freq_q16 * (65536u - (offset_part_q24 >> 8))) >> 16);
+            break;
+        case FX_FADE_IN:
+            vol_q15 = (vol_q15 * tmod_q15) >> 15;
+            break;
+        case FX_FADE_OUT:
+            vol_q15 = (vol_q15 * (32768 - tmod_q15)) >> 15;
+            break;
+        case FX_ARP_FAST:
+        case FX_ARP_SLOW: {
+            uint32_t m = (speed <= 8 ? 32u : 16u) / (fx == FX_ARP_FAST ? 4u : 8u);
+            uint32_t n = (uint32_t)(((uint64_t)(off_q24 >> 12) * m * (uint32_t)speed * 255u) >> 24);
+            int arp_note = (note_idx & ~3) | ((int)n & 3);
+            uint8_t ak = sfx.notes[arp_note].getKey();
+            freq_q16 = (ak < 64) ? s_phase_inc_q16[ak] : 0u;
+            break;
+        }
+        default:
+            break;
+    }
+
+    freq_q16 = (uint32_t)(((uint64_t)freq_q16 * freq_shift_q16) >> 16);
+    int32_t wave = evalWaveformFixed(cur_n.getWaveform(), phi_q16);
+    phi_q16 = (phi_q16 + freq_q16) & 0x007FFFFFu;
+
+    off_q24 = next_off_q24;
+    if (next_off_q24 >= (32u << 24)) {
+        ch.sfxId = -1;
+    } else if (next_note_idx != note_idx) {
+        ch.prev_note.n = cur_n;
+        ch.prev_note.phi = (float)phi_q16 * (1.0f / 65536.0f);
+        ch.current_note.n = sfx.notes[next_note_idx];
+    }
+
+    return (vol_q15 * wave) >> 15;
+}
+
+void Audio::mixSfxFixed(rawSfxChannel &ch, uint32_t freq_shift_q16,
+                        int32_t music_vol_q15, bool apply_music_vol,
+                        int32_t *out, size_t count, int depth) {
+    (void)depth;
+    if (ch.sfxId < 0 || ch.sfxId > 63 || count == 0)
+        return;
+
+    const struct sfx &sfx = _memory->sfx[ch.sfxId];
+    int speed = sfx.speed < 1 ? 1 : (int)sfx.speed;
+    uint32_t inc_q24 = s_inv_speed_q24[speed];
+    uint32_t fade_dur_q24 = inc_q24 * 25u;
+    int loop_start = sfx.loopRangeStart;
+    int loop_end = sfx.loopRangeEnd;
+    int loop_len = loop_end - loop_start;
+    bool has_loop = (loop_len > 0) && ch.can_loop;
+    uint32_t loop_start_q24 = (uint32_t)loop_start << 24;
+    uint32_t loop_end_q24 = (uint32_t)loop_end << 24;
+    uint32_t loop_len_q24 = (uint32_t)loop_len << 24;
+    int len_notes = loop_end == 0 ? 32 : loop_end;
+    uint32_t off_q24 = floatOffsetToQ24(ch.offset);
+    uint32_t phi_q16 = floatPhiToQ16(ch.current_note.phi);
+    uint32_t prev_phi_q16 = floatPhiToQ16(ch.prev_note.phi);
+    rawSfxChannel *childCh = ch.getChildChannel();
+    rawSfxChannel *prevChildCh = ch.getPrevChildChannel();
+    uint32_t c_off_q24 = childCh ? floatOffsetToQ24(childCh->offset) : 0u;
+    uint32_t c_phi_q16 = childCh ? floatPhiToQ16(childCh->current_note.phi) : 0u;
+    uint32_t pc_off_q24 = prevChildCh ? floatOffsetToQ24(prevChildCh->offset) : 0u;
+    uint32_t pc_phi_q16 = prevChildCh ? floatPhiToQ16(prevChildCh->current_note.phi) : 0u;
+
+    for (size_t i = 0; i < count; ++i) {
+        if (ch.sfxId < 0)
+            break;
+
+        uint32_t next_off_q24 = off_q24 + inc_q24;
+        if (has_loop && next_off_q24 >= loop_end_q24) {
+            next_off_q24 -= loop_len_q24;
+            if (next_off_q24 >= loop_end_q24)
+                next_off_q24 = loop_start_q24 + (next_off_q24 - loop_start_q24) % loop_len_q24;
+        }
+
+        int note_idx = (int)(off_q24 >> 24);
+        if (note_idx >= 32) {
+            ch.sfxId = -1;
+            if (childCh)
+                childCh->sfxId = -1;
+            break;
+        }
+        note cur_n = sfx.notes[note_idx];
+        ch.current_note.n = cur_n;
+        int next_note_idx = (int)(next_off_q24 >> 24);
+
+        uint32_t offset_part_q24 = off_q24 & 0x00FFFFFFu;
+        int32_t crossfade_q15 = 0;
+        if (offset_part_q24 < fade_dur_q24) {
+            crossfade_q15 = (int32_t)(((uint64_t)(fade_dur_q24 - offset_part_q24) << 15) / fade_dur_q24);
+        }
+
+        // Primary note synthesis
+        uint8_t key = cur_n.getKey();
+        uint32_t freq_q16 = (key < 64) ? s_phase_inc_q16[key] : 0u;
+        int32_t vol_q15 = s_vol_q15[cur_n.getVolume() & 7];
+        int32_t tmod_q15 = (int32_t)(offset_part_q24 >> 9);
+        int fx = cur_n.getEffect();
+
+        switch (fx) {
+            case FX_SLIDE: {
+                uint8_t pk = ch.prev_note.n.getKey();
+                uint32_t pf = (pk < 64) ? s_phase_inc_q16[pk] : 0u;
+                freq_q16 = (uint32_t)((int32_t)pf + (((int64_t)((int32_t)freq_q16 - (int32_t)pf) * tmod_q15) >> 15));
+                if (ch.prev_note.n.getVolume() > 0) {
+                    int32_t pv = s_vol_q15[ch.prev_note.n.getVolume() & 7];
+                    vol_q15 = pv + (((vol_q15 - pv) * tmod_q15) >> 15);
+                }
+                break;
+            }
+            case FX_VIBRATO: {
+                uint32_t vib_idx = (((uint32_t)tmod_q15 * (uint32_t)speed * 127u) >> 18) & 0xFFu;
+                int32_t vt = s_vib_lut[vib_idx];
+                freq_q16 = (uint32_t)((int64_t)freq_q16 + (((int64_t)freq_q16 * 3898 * vt) >> 30));
+                break;
+            }
+            case FX_DROP:
+                freq_q16 = (uint32_t)(((uint64_t)freq_q16 * (65536u - (offset_part_q24 >> 8))) >> 16);
+                break;
+            case FX_FADE_IN:
+                vol_q15 = (vol_q15 * tmod_q15) >> 15;
+                break;
+            case FX_FADE_OUT:
+                vol_q15 = (vol_q15 * (32768 - tmod_q15)) >> 15;
+                break;
+            case FX_ARP_FAST:
+            case FX_ARP_SLOW: {
+                uint32_t m = (speed <= 8 ? 32u : 16u) / (fx == FX_ARP_FAST ? 4u : 8u);
+                uint32_t n = (uint32_t)(((uint64_t)(off_q24 >> 12) * m * (uint32_t)speed * 255u) >> 24);
+                int arp_note = (note_idx & ~3) | ((int)n & 3);
+                uint8_t ak = sfx.notes[arp_note].getKey();
+                freq_q16 = (ak < 64) ? s_phase_inc_q16[ak] : 0u;
+                break;
+            }
+            default:
+                break;
+        }
+        if (freq_shift_q16 != 65536u)
+            freq_q16 = (uint32_t)(((uint64_t)freq_q16 * freq_shift_q16) >> 16);
+
+        bool custom = (bool)cur_n.getCustom() && childCh != NULL;
+        int32_t sample_q15;
+        if (custom) {
+            if (childCh->sfxId == -1) {
+                childCh->sfxId = cur_n.getWaveform();
+                childCh->offset = 0.0f;
+                childCh->current_note.phi = 0.0f;
+                childCh->can_loop = true;
+                childCh->is_music = false;
+                childCh->prev_note.n.setKey(0);
+                childCh->prev_note.n.setVolume(0);
+                c_off_q24 = 0u;
+                c_phi_q16 = 0u;
+            }
+            uint32_t c_shift_q16 = (uint32_t)(((uint64_t)freq_q16 << 16) / s_c2_freq_q16);
+            int32_t cw = evalChildSfxSampleFixed(_memory, *childCh, c_off_q24, c_phi_q16, c_shift_q16);
+            sample_q15 = (vol_q15 * cw) >> 15;
+        } else {
+            int32_t w = evalWaveformFixed(cur_n.getWaveform(), phi_q16);
+            sample_q15 = (vol_q15 * w) >> 15;
+        }
+        phi_q16 = (phi_q16 + freq_q16) & 0x007FFFFFu;
+
+        if (crossfade_q15 > 0) {
+            note prev_n = ch.prev_note.n;
+            uint8_t pkey = prev_n.getKey();
+            uint32_t pfreq_q16 = (pkey < 64) ? s_phase_inc_q16[pkey] : 0u;
+            int32_t pvol_q15 = s_vol_q15[prev_n.getVolume() & 7];
+            int pfx = prev_n.getEffect();
+            int32_t ptmod_q15 = 32768 + tmod_q15;
+            switch (pfx) {
+                case FX_VIBRATO: {
+                    uint32_t vib_idx = (((uint32_t)ptmod_q15 * (uint32_t)speed * 127u) >> 18) & 0xFFu;
+                    int32_t vt = s_vib_lut[vib_idx];
+                    pfreq_q16 = (uint32_t)((int64_t)pfreq_q16 + (((int64_t)pfreq_q16 * 3898 * vt) >> 30));
+                    break;
+                }
+                case FX_DROP:
+                    pfreq_q16 = (uint32_t)(((uint64_t)pfreq_q16 * (65536u - (offset_part_q24 >> 8))) >> 16);
+                    break;
+                case FX_FADE_OUT:
+                    pvol_q15 = 0;
+                    break;
