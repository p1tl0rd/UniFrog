+        stb_vorbis_close(slot->dec.stb);
+        slot->dec.stb = NULL;
+    }
+#endif
+    srcClose(&slot->src);
+    slot->streamKind = STREAM_NONE;
+    slot->isStream = false;
+    slot->streamEof = false;
+    slot->scratchSamples = 0;
+    slot->scratchPos = 0;
