From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Tue, 24 Nov 2026 14:42:43 +0700
Subject: [PATCH 2/2] Use integer LUT sin/cos and integer sqrt on SF2000

---
 lpico8lib.c | 64 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/lpico8lib.c b/lpico8lib.c
index 8712b4e06ac072bcfb8157534e9121ff1f0e94d2..28e7766199e165849c3b6f075c5e32aceeff8381 100644
--- a/lpico8lib.c
+++ b/lpico8lib.c
@@ -59,6 +59,43 @@ static int pico8_flr(lua_State *l) {
 //using modf to get fractional part of number here because bittboy build seems to have problems
 //with numbers > 1 (treats them as ints?)
 //would be better to just replace these with lookup tables using the fractional part
+#if defined(SF2000)
+static int32_t s_p8_sin_lut[257];
+static bool s_p8_sin_lut_init = false;
+
+static void pico8_init_sin_lut(void) {
+    if (s_p8_sin_lut_init)
+        return;
+    for (int i = 0; i <= 256; i++) {
+        double v = std::sin(-TAU * (double)i / 256.0) * 65536.0;
+        s_p8_sin_lut[i] = (int32_t)(v >= 0.0 ? v + 0.5 : v - 0.5);
+    }
+    s_p8_sin_lut_init = true;
+}
+
+static inline int32_t pico8_sin_fixed(int32_t bits) {
+    if (!s_p8_sin_lut_init)
+        pico8_init_sin_lut();
+    uint32_t phase = (uint32_t)bits & 0xffffu;
+    uint32_t idx = phase >> 8;
+    int32_t frac = (int32_t)(phase & 0xffu);
+    int32_t a = s_p8_sin_lut[idx];
+    int32_t b = s_p8_sin_lut[idx + 1];
+    return a + (((b - a) * frac) >> 8);
+}
+
+static int pico8_cos(lua_State *l) {
+    int32_t bits = lua_tonumber(l, 1).bits();
+    lua_pushnumber(l, lua_Number::frombits(pico8_sin_fixed(bits - 0x4000)));
+    return 1;
+}
+
+static int pico8_sin(lua_State *l) {
+    int32_t bits = lua_tonumber(l, 1).bits();
+    lua_pushnumber(l, lua_Number::frombits(pico8_sin_fixed(bits)));
+    return 1;
+}
+#else
 static int pico8_cos(lua_State *l) {
     lua_pushnumber(l, cast_num(std::cos(-TAU * (double)(lua_Number::modf(lua_tonumber(l, 1))))));
     return 1;
@@ -68,6 +105,7 @@ static int pico8_sin(lua_State *l) {
     lua_pushnumber(l, cast_num(std::sin(-TAU * (double)(lua_Number::modf(lua_tonumber(l, 1))))));
     return 1;
 }
+#endif
 
 static int pico8_atan2(lua_State *l) {
     lua_Number x = lua_tonumber(l, 1);
@@ -79,11 +117,37 @@ static int pico8_atan2(lua_State *l) {
     return 1;
 }
 
+#if defined(SF2000)
+static int pico8_sqrt(lua_State *l) {
+    int32_t bits = lua_tonumber(l, 1).bits();
+    if (bits <= 0) {
+        lua_pushnumber(l, lua_Number(0));
+        return 1;
+    }
+    uint64_t n = (uint64_t)(uint32_t)bits << 16;
+    uint64_t res = 0;
+    uint64_t bit = 1ULL << 46;
+    while (bit > n)
+        bit >>= 2;
+    while (bit != 0) {
+        if (n >= res + bit) {
+            n -= res + bit;
+            res = (res >> 1) + bit;
+        } else {
+            res >>= 1;
+        }
+        bit >>= 2;
+    }
+    lua_pushnumber(l, lua_Number::frombits((int32_t)res));
+    return 1;
+}
+#else
 static int pico8_sqrt(lua_State *l) {
     lua_Number x = lua_tonumber(l, 1);
     lua_pushnumber(l, cast_num(x.bits() >= 0 ? std::sqrt((double)x) : 0));
     return 1;
 }
+#endif
 
 static int pico8_abs(lua_State *l) {
     lua_pushnumber(l, lua_Number::abs(lua_tonumber(l, 1)));
