+static inline int64_t Collision_roundQ16(GMLReal v) {
+    GMLReal s = v * 65536.0;
+    return (s >= 0.0) ? (int64_t)(s + 0.5) : (int64_t)(s - 0.5);
+}
+
+typedef struct {
+    int64_t rowLx, rowLy;
+    int64_t dlxDx, dlyDx;
+    int64_t dlxDy, dlyDy;
+    int32_t sprW, sprH;
+    const uint8_t* mask;
+    int32_t maskOffX, maskOffY;
+    int32_t maskW, maskH;
+    uint32_t bytesPerRow;
+} CollisionPreciseScan;
+
+static inline bool Collision_initPreciseScan(Sprite* spr, Instance* inst, bool precise,
+                                             GMLReal startWx, GMLReal startWy,
+                                             CollisionPreciseScan* out) {
+    if (0.0001 > GMLReal_fabs(inst->imageXscale)) return false;
+    if (0.0001 > GMLReal_fabs(inst->imageYscale)) return false;
+
+    GMLReal invSx = 1.0 / inst->imageXscale;
+    GMLReal invSy = 1.0 / inst->imageYscale;
+    GMLReal cs = 1.0, sn = 0.0;
+    if (inst->imageAngle != 0.0 && GMLReal_fabs(inst->imageAngle) > 0.0001) {
+        GMLReal rad = inst->imageAngle * M_PI / 180.0;
+        cs = GMLReal_cos(rad);
+        sn = GMLReal_sin(rad);
+    }
+
+    GMLReal dx0 = startWx - inst->x;
+    GMLReal dy0 = startWy - inst->y;
+    GMLReal lx0 = (cs * dx0 - sn * dy0) * invSx + (GMLReal)spr->originX;
+    GMLReal ly0 = (sn * dx0 + cs * dy0) * invSy + (GMLReal)spr->originY;
+
+    out->rowLx = Collision_roundQ16(lx0);
+    out->rowLy = Collision_roundQ16(ly0);
+    out->dlxDx = Collision_roundQ16(cs * invSx);
+    out->dlyDx = Collision_roundQ16(sn * invSy);
+    out->dlxDy = Collision_roundQ16(-sn * invSx);
+    out->dlyDy = Collision_roundQ16(cs * invSy);
+    out->sprW = (int32_t)spr->width;
+    out->sprH = (int32_t)spr->height;
+
+    if (precise) {
+        uint32_t frameIdx = ((uint32_t)inst->imageIndex) % spr->maskCount;
+        out->mask = spr->masks[frameIdx];
+        out->maskOffX = spr->maskOffsetX;
+        out->maskOffY = spr->maskOffsetY;
+        out->maskW = (int32_t)spr->maskWidth;
+        out->maskH = (int32_t)spr->maskHeight;
+        out->bytesPerRow = (spr->maskWidth + 7) / 8;
+    } else {
+        out->mask = nullptr;
+        out->maskOffX = 0;
+        out->maskOffY = 0;
+        out->maskW = 0;
+        out->maskH = 0;
+        out->bytesPerRow = 0;
+    }
+    return true;
+}
+
+static inline bool Collision_stepPointHit(const CollisionPreciseScan* s, int64_t lx, int64_t ly) {
+    if (lx <= -65536 || ly <= -65536) return false;
+    int32_t ix = (lx < 0) ? 0 : (int32_t)(lx >> 16);
+    int32_t iy = (ly < 0) ? 0 : (int32_t)(ly >> 16);
+    if (ix >= s->sprW || iy >= s->sprH) return false;
+    if (s->mask == nullptr) return true;
+    int32_t mx = ix - s->maskOffX;
+    int32_t my = iy - s->maskOffY;
+    if (mx < 0 || my < 0 || mx >= s->maskW || my >= s->maskH) return false;
+    return (s->mask[(uint32_t)my * s->bytesPerRow + ((uint32_t)mx >> 3)] & (1 << (7 - (mx & 7)))) != 0;
+}
+
