+/* ---------------------------------------------------------------------------
+ * Buffered / RAM-preloaded data source for streamed audio
+ * --------------------------------------------------------------------------- */
+
+typedef struct {
+    const uint8_t* mem;
+    uint32_t memSize;
+    uint32_t memPos;
+    bool ownsMem;
+    FILE* file;
+    char* ioBuf;
+} AudioDataSource;
+
+static bool srcOpenFile(AudioDataSource* src, const char* path) {
+    memset(src, 0, sizeof(*src));
+    if (!path) return false;
+    FILE* f = fopen(path, "rb");
+    if (!f) return false;
+
+    long fileSize = -1;
+    if (fseek(f, 0, SEEK_END) == 0) {
+        fileSize = ftell(f);
+        fseek(f, 0, SEEK_SET);
+    }
+
+    if (fileSize > 0 && (uint32_t)fileSize <= AUDIO_RAM_PRELOAD_MAX) {
+        uint8_t* buf = (uint8_t*)malloc((size_t)fileSize);
+        if (buf) {
+            size_t got = fread(buf, 1, (size_t)fileSize, f);
+            fclose(f);
+            if (got == (size_t)fileSize) {
+                src->mem = buf;
+                src->memSize = (uint32_t)got;
+                src->memPos = 0;
+                src->ownsMem = true;
+                return true;
+            }
+            free(buf);
+            /* Re-open for streaming fallback if fread was short */
+            f = fopen(path, "rb");
+            if (!f) return false;
+        }
+    }
+
+    src->ioBuf = (char*)malloc(AUDIO_FILE_IOBUF_SIZE);
+    if (src->ioBuf) {
+        setvbuf(f, src->ioBuf, _IOFBF, AUDIO_FILE_IOBUF_SIZE);
+    }
+    src->file = f;
+    return true;
+}
+
+static bool srcOpenMemory(AudioDataSource* src, const uint8_t* data, uint32_t size) {
+    memset(src, 0, sizeof(*src));
+    if (!data || size == 0) return false;
+    src->mem = data;
+    src->memSize = size;
+    src->memPos = 0;
+    src->ownsMem = false;
+    return true;
+}
+
+static void srcClose(AudioDataSource* src) {
+    if (src->ownsMem && src->mem) {
+        free((void*)src->mem);
+    }
+    if (src->file) {
+        fclose(src->file);
+    }
+    if (src->ioBuf) {
+        free(src->ioBuf);
+    }
+    memset(src, 0, sizeof(*src));
+}
+
+static size_t srcRead(AudioDataSource* src, void* dst, size_t bytes) {
+    if (src->mem) {
+        uint32_t avail = src->memSize - src->memPos;
+        if (bytes > avail) bytes = avail;
+        if (bytes > 0) {
+            memcpy(dst, src->mem + src->memPos, bytes);
+            src->memPos += (uint32_t)bytes;
+        }
+        return bytes;
+    }
+    if (src->file) {
+        return fread(dst, 1, bytes, src->file);
+    }
+    return 0;
+}
+
+static bool srcSeek(AudioDataSource* src, uint32_t offset) {
+    if (src->mem) {
+        if (offset > src->memSize) offset = src->memSize;
+        src->memPos = offset;
+        return true;
+    }
+    if (src->file) {
+        return fseek(src->file, (long)offset, SEEK_SET) == 0;
+    }
+    return false;
+}
+
+static uint32_t srcTell(const AudioDataSource* src) {
+    if (src->mem) return src->memPos;
+    if (src->file) {
+        long p = ftell(src->file);
+        return p >= 0 ? (uint32_t)p : 0u;
+    }
+    return 0;
+}
