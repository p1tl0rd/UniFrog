     SwRenderer_present();
@@ -26,13 +32,16 @@ void platformSwapBuffers(void) {
 }
 void *platformGetProcAddress(const char *name) { (void)name; return NULL; }
 bool platformHandleEvents(void) {
+#ifdef PLATFORM_UNIFROG
+    if (libretro_should_exit()) return true;
+#endif
     if (!runner) return false;
     bool up = libretro_input(RETRO_DEVICE_ID_JOYPAD_UP);
     bool down = libretro_input(RETRO_DEVICE_ID_JOYPAD_DOWN);
     bool left = libretro_input(RETRO_DEVICE_ID_JOYPAD_LEFT);
     bool right = libretro_input(RETRO_DEVICE_ID_JOYPAD_RIGHT);
-    bool confirm = libretro_input(RETRO_DEVICE_ID_JOYPAD_A) || libretro_input(RETRO_DEVICE_ID_JOYPAD_R);
-    bool cancel = libretro_input(RETRO_DEVICE_ID_JOYPAD_B) || libretro_input(RETRO_DEVICE_ID_JOYPAD_L);
+    bool confirm = libretro_input(RETRO_DEVICE_ID_JOYPAD_A) || libretro_input(RETRO_DEVICE_ID_JOYPAD_R) || libretro_input(RETRO_DEVICE_ID_JOYPAD_START);
+    bool cancel = libretro_input(RETRO_DEVICE_ID_JOYPAD_B) || libretro_input(RETRO_DEVICE_ID_JOYPAD_Y) || libretro_input(RETRO_DEVICE_ID_JOYPAD_L);
     bool menu = libretro_input(RETRO_DEVICE_ID_JOYPAD_X) || libretro_input(RETRO_DEVICE_ID_JOYPAD_SELECT);
     const int keys[] = {VK_UP, VK_DOWN, VK_LEFT, VK_RIGHT, 'Z', VK_ENTER, VK_SPACE, 'X', VK_SHIFT, 'C', VK_CONTROL};
     const bool down_now[] = {up, down, left, right, confirm, confirm, confirm, cancel, cancel, menu, menu};
@@ -71,5 +80,11 @@ void platformSetWindowTitle(const char *title) { (void)title; }
 void platformSleepUntil(uint64_t time) { (void)time; libretro_yield_frame(); }
 
 void platformLog(const logType type, const char *format, va_list args) {
-    (void)type; vfprintf(stderr, format, args);
+#ifdef PLATFORM_UNIFROG
+    if (type != LOG_TYPE_ERROR && type != LOG_TYPE_WARNING) return;
+    vprintf(format, args);
+#else
+    (void)type;
+    vfprintf(stderr, format, args);
+#endif
 }
diff --git a/src/data_win.c b/src/data_win.c
index 5c609c9aba1fad65f110debb8f4db90376ad3df3..6ab9ba01a9c9b512762f0c018587b79f990d9733 100644
--- a/src/data_win.c
+++ b/src/data_win.c
@@ -1,5 +1,6 @@
 #include "data_win.h"
 #include "binary_reader.h"
