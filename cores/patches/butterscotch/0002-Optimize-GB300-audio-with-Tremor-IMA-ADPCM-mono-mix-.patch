+    uint32_t pktLen;
+    uint32_t pktCap;
+
+    uint32_t audioStartPageOffset;
+    uint8_t audioStartSegIdx;
+} TremorStreamState;
+
+static bool oggReadNextPage(AudioDataSource* src, TremorStreamState* ts) {
+    uint8_t hdr[27];
+    uint32_t pageStart = srcTell(src);
+    if (srcRead(src, hdr, 27) != 27) return false;
+    if (memcmp(hdr, "OggS", 4) != 0) return false;
+
+    uint8_t nseg = hdr[26];
+    if (nseg > 0 && srcRead(src, ts->segTable, nseg) != nseg) return false;
+
+    uint32_t bodyLen = 0;
+    for (uint8_t i = 0; i < nseg; i++) bodyLen += ts->segTable[i];
+
+    if (bodyLen > ts->pageBufCap) {
+        uint8_t* nb = (uint8_t*)realloc(ts->pageBuf, bodyLen);
+        if (!nb) return false;
+        ts->pageBuf = nb;
+        ts->pageBufCap = bodyLen;
+    }
+    if (bodyLen > 0 && srcRead(src, ts->pageBuf, bodyLen) != bodyLen) return false;
+
+    ts->currentPageFileOffset = pageStart;
+    ts->nseg = nseg;
+    ts->segIdx = 0;
+    ts->pageBodyOffset = 0;
+    return true;
+}
+
+static bool oggNextPacket(AudioDataSource* src, TremorStreamState* ts,
+                          const uint8_t** outData, uint32_t* outLen) {
+    ts->pktLen = 0;
+    for (;;) {
+        if (ts->segIdx >= ts->nseg) {
+            if (!oggReadNextPage(src, ts)) return false;
+        }
+        while (ts->segIdx < ts->nseg) {
+            uint8_t seg = ts->segTable[ts->segIdx++];
+            if (ts->pktLen + seg > ts->pktCap) {
+                uint32_t newCap = ts->pktCap ? ts->pktCap * 2u : 4096u;
+                while (newCap < ts->pktLen + seg) newCap *= 2u;
+                uint8_t* nb = (uint8_t*)realloc(ts->pktBuf, newCap);
+                if (!nb) return false;
+                ts->pktBuf = nb;
+                ts->pktCap = newCap;
+            }
+            if (seg > 0) {
+                memcpy(ts->pktBuf + ts->pktLen, ts->pageBuf + ts->pageBodyOffset, seg);
+                ts->pktLen += seg;
+                ts->pageBodyOffset += seg;
+            }
+            if (seg < 255u) {
+                *outData = ts->pktBuf;
+                *outLen = ts->pktLen;
+                return true;
+            }
+        }
+    }
+}
+
+static int xiphLace(uint8_t* dst, int pos, uint32_t val) {
+    while (val >= 255u) {
+        dst[pos++] = 255u;
+        val -= 255u;
+    }
+    dst[pos++] = (uint8_t)val;
+    return pos;
+}
+
+static void tremorStreamClose(TremorStreamState* ts) {
+    if (ts->ctx) {
+        vorbis_destroy(ts->ctx);
+        ts->ctx = NULL;
+    }
+    free(ts->pageBuf);
+    free(ts->pktBuf);
+    memset(ts, 0, sizeof(*ts));
+}
+
+static bool tremorStreamOpen(AudioDataSource* src, TremorStreamState* ts) {
+    memset(ts, 0, sizeof(*ts));
+
+    uint8_t* hdrs[3] = {NULL, NULL, NULL};
+    uint32_t hdrLens[3] = {0, 0, 0};
+
+    for (int i = 0; i < 3; i++) {
+        const uint8_t* pkt = NULL;
+        uint32_t len = 0;
+        if (!oggNextPacket(src, ts, &pkt, &len) || len < 7 || memcmp(pkt + 1, "vorbis", 6) != 0) {
+            goto fail;
+        }
+        if (i == 0) {
+            if (len < 30 || pkt[0] != 1) goto fail;
+            ts->channels = pkt[11];
+            ts->sampleRate = readU32LE(pkt + 12);
+            if (ts->channels == 0 || ts->sampleRate == 0) goto fail;
+        }
+        hdrs[i] = (uint8_t*)malloc(len);
+        if (!hdrs[i]) goto fail;
+        memcpy(hdrs[i], pkt, len);
+        hdrLens[i] = len;
+    }
+
+    if (ts->segIdx < ts->nseg) {
+        ts->audioStartPageOffset = ts->currentPageFileOffset;
+        ts->audioStartSegIdx = ts->segIdx;
+    } else {
+        ts->audioStartPageOffset = srcTell(src);
+        ts->audioStartSegIdx = 0;
+    }
+
+    uint32_t extraCap = 1u + (hdrLens[0] / 255u + 1u) + (hdrLens[1] / 255u + 1u) +
+                        hdrLens[0] + hdrLens[1] + hdrLens[2];
+    uint8_t* extra = (uint8_t*)malloc(extraCap);
+    if (!extra) goto fail;
+    int pos = 0;
+    extra[pos++] = 2u;
+    pos = xiphLace(extra, pos, hdrLens[0]);
+    pos = xiphLace(extra, pos, hdrLens[1]);
+    memcpy(extra + pos, hdrs[0], hdrLens[0]); pos += (int)hdrLens[0];
+    memcpy(extra + pos, hdrs[1], hdrLens[1]); pos += (int)hdrLens[1];
+    memcpy(extra + pos, hdrs[2], hdrLens[2]); pos += (int)hdrLens[2];
+
+    ts->ctx = vorbis_create(extra, pos);
+    free(extra);
+    for (int i = 0; i < 3; i++) free(hdrs[i]);
+    if (!ts->ctx) {
+        tremorStreamClose(ts);
+        return false;
+    }
+    return true;
+
+fail:
+    for (int i = 0; i < 3; i++) free(hdrs[i]);
+    tremorStreamClose(ts);
+    return false;
+}
+
+static bool tremorStreamRewind(AudioDataSource* src, TremorStreamState* ts) {
+    if (!ts->ctx) return false;
+    if (!srcSeek(src, ts->audioStartPageOffset)) return false;
+    ts->nseg = 0;
+    ts->segIdx = 0;
+    ts->pageBodyOffset = 0;
+    if (ts->audioStartSegIdx > 0) {
+        if (!oggReadNextPage(src, ts)) return false;
+        for (uint8_t i = 0; i < ts->audioStartSegIdx && i < ts->nseg; i++) {
+            ts->pageBodyOffset += ts->segTable[i];
+        }
+        ts->segIdx = ts->audioStartSegIdx;
+    }
+    vorbis_flush(ts->ctx);
+    return true;
 }
 
+static int tremorStreamDecodeMono(AudioDataSource* src, TremorStreamState* ts, int16_t* outMono, int maxOut) {
+    if (!ts->ctx || maxOut <= 0) return 0;
+    int errStreak = 0;
+    for (;;) {
+        const uint8_t* pkt = NULL;
+        uint32_t pktLen = 0;
+        if (!oggNextPacket(src, ts, &pkt, &pktLen)) return 0;
+
+        int rate = (int)ts->sampleRate;
+        int ch = (int)ts->channels;
+        int frames = vorbis_decode(ts->ctx, pkt, (int)pktLen, s_vorbisPcmTmp,
+                                   (int)(sizeof(s_vorbisPcmTmp) / sizeof(s_vorbisPcmTmp[0])),
+                                   &rate, &ch);
+        if (frames == -14 || frames == 0) {
+            /* Vorbis overlap-add needs 2 packets before yielding PCM */
+            errStreak = 0;
+            continue;
+        }
+        if (frames < 0) {
+            if (++errStreak >= 16) return 0;
+            continue;
+        }
+        if (frames > maxOut) frames = maxOut;
+        if (ch <= 1) {
+            memcpy(outMono, s_vorbisPcmTmp, (size_t)frames * sizeof(int16_t));
+        } else {
+            for (int i = 0; i < frames; i++) {
+                int idx = i * ch;
+                outMono[i] = (int16_t)(((int32_t)s_vorbisPcmTmp[idx] + (int32_t)s_vorbisPcmTmp[idx + 1]) >> 1);
+            }
+        }
+        return frames;
+    }
+}
