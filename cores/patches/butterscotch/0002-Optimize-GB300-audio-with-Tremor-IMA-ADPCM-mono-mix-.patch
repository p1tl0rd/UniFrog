+static bool openStreamFromFile(SoundSlot* slot, const char* path) {
+    if (!path) return false;
+    if (!srcOpenFile(&slot->src, path)) return false;
+
+    const char* dot = strrchr(path, '.');
+    if (dot && strcasecmp(dot, ".wav") == 0) {
+        if (wavStreamOpen(&slot->src, &slot->dec.wav)) {
+            slot->streamKind = STREAM_WAV_FILE;
+            slot->isStream = true;
+            slot->channels = 1;
+            slot->sampleRate = (int32_t)slot->dec.wav.sampleRate;
+            return true;
+        }
+        srcClose(&slot->src);
+        return false;
+    }
+
+#ifdef USE_HCRTOS_TREMOR
+    if (tremorStreamOpen(&slot->src, &slot->dec.tremor)) {
+        slot->streamKind = STREAM_OGG_TREMOR;
+        slot->isStream = true;
+        slot->channels = 1;
+        slot->sampleRate = (int32_t)slot->dec.tremor.sampleRate;
+        return true;
+    }
+    srcClose(&slot->src);
+    return false;
+#else
+    srcClose(&slot->src);
+    int error = 0;
+    slot->dec.stb = stb_vorbis_open_filename((char*)path, &error, NULL);
+    if (!slot->dec.stb) return false;
+    stb_vorbis_info info = stb_vorbis_get_info(slot->dec.stb);
+    slot->streamKind = STREAM_OGG_STB;
+    slot->isStream = true;
+    slot->channels = 1;
+    slot->sampleRate = (int32_t)info.sample_rate;
+    return true;
+#endif
