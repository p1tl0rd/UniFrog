From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Wed, 25 Nov 2026 22:51:17 +0700
Subject: [PATCH 4/4] Map undertale and butterscotch cores in FrogUI

---
 frogui_libretro.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/frogui_libretro.c b/frogui_libretro.c
index 54902294bc47dc61c915fc8b398075d5832db52d..b46b70d5a363ad164e007b3ea468fb4792ee8215 100644
--- a/frogui_libretro.c
+++ b/frogui_libretro.c
@@ -49,7 +49,8 @@ static const ConsoleMapping console_mappings[] = {
     {"col", "gearcoleco"}, {"msx", "bluemsx-prosty"},
     {"c64", "frodo-prosty"}, {"fake08", "fake08-prosty"},
     {"pico8", "fake08-prosty"}, {"doom", "prboom"}, {"cavestory", "nxengine"},
-    {"wolf3d", "ecwolf"}, {"m2k", "mame2000"}, {"fba", "fbalpha2012"},
+    {"wolf3d", "ecwolf"}, {"undertale", "butterscotch"},
+    {"butterscotch", "butterscotch"}, {"m2k", "mame2000"}, {"fba", "fbalpha2012"},
     {NULL, NULL}
 };
 
@@ -186,6 +187,8 @@ static const char *core_for_game(const char *folder, const char *filename)
     if (!strcasecmp(ext, ".wl6") || !strcasecmp(ext, ".wl1") ||
         !strcasecmp(ext, ".sod") || !strcasecmp(ext, ".sdm") ||
         !strcasecmp(ext, ".n3d")) return "ecwolf";
+    if (!strcasecmp(ext, ".unx") || !strcasecmp(ext, ".win") ||
+        !strcasecmp(ext, ".butterscotch")) return "butterscotch";
     if (!strcasecmp(ext, ".nes") || !strcasecmp(ext, ".fds")) return "fceumm";
     if (!strcasecmp(ext, ".sfc") || !strcasecmp(ext, ".smc")) return "snes9x2005";
     if (!strcasecmp(ext, ".gb") || !strcasecmp(ext, ".gbc")) return "gambatte";
