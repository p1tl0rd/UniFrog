From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UniFrog Builder <unifrog@local>
Date: Tue, 24 Nov 2026 13:41:56 +0700
Subject: [PATCH 2/2] Avoid per-entry stat() stalls and support PICO-8 carts in
 FrogUI

---
 frogui_libretro.c | 42 ++++++++++++++++++++++++++++++++----------
 1 file changed, 32 insertions(+), 10 deletions(-)

diff --git a/frogui_libretro.c b/frogui_libretro.c
index a52bd63ddc991838bf7e6c557f9f4a3f8a91f384..1b6e145f9a19aff59280a5decc708a31bbe0d1db 100644
--- a/frogui_libretro.c
+++ b/frogui_libretro.c
@@ -48,7 +48,7 @@ static const ConsoleMapping console_mappings[] = {
     {"pce", "pce-fast"}, {"ngpc", "race"}, {"wswan", "beetle-cygne"},
     {"col", "gearcoleco"}, {"msx", "bluemsx-prosty"},
     {"c64", "frodo-prosty"}, {"fake08", "fake08-prosty"},
-    {"m2k", "mame2000"}, {"fba", "fbalpha2012"},
+    {"pico8", "fake08-prosty"}, {"m2k", "mame2000"}, {"fba", "fbalpha2012"},
     {NULL, NULL}
 };
 
@@ -172,8 +172,14 @@ static const char *core_for_game(const char *folder, const char *filename)
     for (unsigned i = 0; console_mappings[i].folder; ++i)
         if (strcasecmp(console_mappings[i].folder, folder) == 0)
             return console_mappings[i].core;
+    {
+        size_t flen = strlen(filename);
+        if (flen >= 7 && !strcasecmp(filename + flen - 7, ".p8.png"))
+            return "fake08-prosty";
+    }
     ext = strrchr(filename, '.');
     if (!ext) return NULL;
+    if (!strcasecmp(ext, ".p8")) return "fake08-prosty";
     if (!strcasecmp(ext, ".nes") || !strcasecmp(ext, ".fds")) return "fceumm";
     if (!strcasecmp(ext, ".sfc") || !strcasecmp(ext, ".smc")) return "snes9x2005";
     if (!strcasecmp(ext, ".gb") || !strcasecmp(ext, ".gbc")) return "gambatte";
@@ -216,20 +222,36 @@ static void scan_directory(const char *path)
     }
     entry_count = 0;
     while ((entry = readdir(dir)) != NULL) {
-        struct stat st;
-        char full[MAX_PATH_LEN];
+        int is_dir = -1;
+        size_t name_len;
         const char *ext;
         if (entry->d_name[0] == '.') continue;
-        if (snprintf(full, sizeof(full), "%s/%s", path, entry->d_name) >= (int)sizeof(full) ||
-            stat(full, &st) != 0) continue;
+#ifdef DT_DIR
+        if (entry->d_type == DT_DIR) is_dir = 1;
+#endif
+#ifdef DT_REG
+        if (entry->d_type == DT_REG) is_dir = 0;
+#endif
+        if (is_dir < 0) {
+            struct stat st;
+            char full[MAX_PATH_LEN];
+            if (snprintf(full, sizeof(full), "%s/%s", path, entry->d_name) >= (int)sizeof(full) ||
+                stat(full, &st) != 0) continue;
+            is_dir = S_ISDIR(st.st_mode) ? 1 : 0;
+        }
+        name_len = strlen(entry->d_name);
         ext = strrchr(entry->d_name, '.');
-        if (!S_ISDIR(st.st_mode) && ext &&
-            (!strcasecmp(ext, ".csv") || !strcasecmp(ext, ".txt") ||
-             !strcasecmp(ext, ".xml") || !strcasecmp(ext, ".jpg") ||
-             !strcasecmp(ext, ".png"))) continue;
+        if (!is_dir && ext) {
+            bool is_p8_png = name_len >= 7 &&
+                !strcasecmp(entry->d_name + name_len - 7, ".p8.png");
+            if (!is_p8_png &&
+                (!strcasecmp(ext, ".csv") || !strcasecmp(ext, ".txt") ||
+                 !strcasecmp(ext, ".xml") || !strcasecmp(ext, ".jpg") ||
+                 !strcasecmp(ext, ".png"))) continue;
+        }
         if (reserve_entry() != 0) break;
         text_copy(entries[entry_count].name, sizeof(entries[entry_count].name), entry->d_name);
-        entries[entry_count].is_dir = S_ISDIR(st.st_mode);
+        entries[entry_count].is_dir = is_dir;
         ++entry_count;
     }
     closedir(dir);
-- 
2.43.0

