+    GMLReal startWx = (GMLReal)startX + sampleOffset;
+    GMLReal startWy = (GMLReal)startY + sampleOffset;
+    CollisionPreciseScan scanA, scanB;
+    if (!Collision_initPreciseScan(sprA, a, preciseA, startWx, startWy, &scanA)) return false;
+    if (!Collision_initPreciseScan(sprB, b, preciseB, startWx, startWy, &scanB)) return false;
+
+    for (int32_t py = startY; (compatMode ? py <= endY : py < endY);
+         py++, scanA.rowLx += scanA.dlxDy, scanA.rowLy += scanA.dlyDy,
+               scanB.rowLx += scanB.dlxDy, scanB.rowLy += scanB.dlyDy) {
+        int64_t lxA = scanA.rowLx, lyA = scanA.rowLy;
+        int64_t lxB = scanB.rowLx, lyB = scanB.rowLy;
+        for (int32_t px = startX; (compatMode ? px <= endX : px < endX);
+             px++, lxA += scanA.dlxDx, lyA += scanA.dlyDx,
+                   lxB += scanB.dlxDx, lyB += scanB.dlyDx) {
+            if (!Collision_stepPointHit(&scanA, lxA, lyA)) continue;
+            if (!Collision_stepPointHit(&scanB, lxB, lyB)) continue;
             return true;
         }
     }
